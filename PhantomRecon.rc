// English (United States) resources

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_ENU)
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_PHANTOMRECON          ICON                    "PhantomRecon.ico"

IDI_SMALL               ICON                    "small.ico"


/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDC_PHANTOMRECON MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Open Scan Results (CSV)...",          ID_FILE_OPEN_SCAN
        MENUITEM "&Export Visible Rows to CSV...\tCtrl+E", ID_FILE_EXPORT_ROWS
        MENUITEM SEPARATOR
        MENUITEM "Open &Baseline (Set as Active)...",    ID_FILE_OPEN_BASELINE
        MENUITEM "&Import Baseline (Copy as Default)...", ID_FILE_IMPORT_BASELINE
        MENUITEM "Export &Current Baseline...",          ID_FILE_EXPORT_BASELINE
        MENUITEM "Co&mpare Two Baselines...",            ID_FILE_COMPARE_BASELINES
        MENUITEM SEPARATOR
        MENUITEM "&Settings...",                         32780
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                                IDM_EXIT
    END
    POPUP "&Scans"
    BEGIN
        MENUITEM "Take &Baseline...",                    ID_SCANS_BASELINE
        MENUITEM "&Full Scan (Compare a Folder)...",     ID_SCANS_FULLSCAN
        MENUITEM "F&ast Scan (Installed Programs)",      ID_SCANS_FASTSCAN
        MENUITEM SEPARATOR
        MENUITEM "&Cancel Scan\tEsc",                    ID_SCANS_CANCEL
        MENUITEM SEPARATOR
        MENUITEM "&Weekly Fast Scan",                    ID_SCANS_WEEKLY
    END
    POPUP "&Audit"
    BEGIN
        MENUITEM "&Run Security Audit Again\tF5",        ID_AUDIT_RUN
        MENUITEM "View &Findings and Fixes...\tF6",      ID_AUDIT_FINDINGS
        MENUITEM "Save Audit as &Text...",               ID_AUDIT_SAVE_TEXT
    END
    POPUP "&Reports"
    BEGIN
        MENUITEM "Save &HTML Report...",                 ID_REPORT_HTML
        MENUITEM "Save &JSON Report...",                 ID_REPORT_JSON
        MENUITEM "Save ATT&&CK &Navigator Layer...",     ID_REPORT_NAVIGATOR
        MENUITEM SEPARATOR
        MENUITEM "&Hide Names in Reports",               ID_REPORT_REDACT
        MENUITEM "&Open Reports Folder",                 ID_REPORT_OPEN_FOLDER
    END
    POPUP "Res&ults"
    BEGIN
        MENUITEM "Show &Details\tEnter",                 ID_RESULTS_DETAILS
        MENUITEM "Copy Full &Path\tCtrl+C",              ID_RESULTS_COPY_PATH
        MENUITEM "Copy &SHA-256",                        ID_RESULTS_COPY_SHA
        MENUITEM "Open File &Location",                  ID_RESULTS_OPEN_LOCATION
        MENUITEM "Ask the AI &About This File",          ID_RESULTS_TRIAGE
        MENUITEM SEPARATOR
        MENUITEM "&Search\tCtrl+F",                      ID_RESULTS_FOCUS_SEARCH
        MENUITEM "C&lear Results",                       ID_RESULTS_CLEAR
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&Getting Started...",                  ID_HELP_GETTING_STARTED
        MENUITEM "Create &Sample Pack...",               ID_HELP_SAMPLES
        MENUITEM SEPARATOR
        MENUITEM "&About Phantom Recon...",              IDM_ABOUT
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDC_PHANTOMRECON ACCELERATORS
BEGIN
    "?",            IDM_ABOUT,              ASCII,  ALT
    "/",            IDM_ABOUT,              ASCII,  ALT
    VK_ESCAPE,      ID_SCANS_CANCEL_KEY,    VIRTKEY, NOINVERT
    VK_F5,          ID_AUDIT_RUN,           VIRTKEY, NOINVERT
    VK_F6,          ID_AUDIT_FINDINGS,      VIRTKEY, NOINVERT
    "E",            ID_FILE_EXPORT_ROWS,    VIRTKEY, CONTROL, NOINVERT
    "F",            ID_RESULTS_FOCUS_SEARCH, VIRTKEY, CONTROL, NOINVERT
END


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOGEX 0, 0, 250, 96
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About Phantom Recon"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    ICON            IDI_PHANTOMRECON,IDC_STATIC,14,14,21,20
    LTEXT           "Phantom Recon",IDC_ABOUT_VERSION,42,14,200,8,SS_NOPREFIX
    LTEXT           "Defensive Windows auditing. Free for noncommercial use under the PolyForm Noncommercial License 1.0.0.",IDC_ABOUT_LICENSE,42,28,200,26
    LTEXT           "Nothing leaves this computer unless you turn on the AI panel and point it elsewhere.",IDC_STATIC,42,56,200,18
    DEFPUSHBUTTON   "OK",IDOK,193,76,50,14,WS_GROUP
END


IDD_GETTING_STARTED DIALOGEX 0, 0, 330, 176
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Getting Started with Phantom Recon"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "",IDC_GS_TEXT,12,10,306,128
    CONTROL         "Show this when the program starts",IDC_GS_SHOW,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,142,180,12
    PUSHBUTTON      "Create Sample Pack...",IDC_GS_SAMPLES,160,156,100,15
    DEFPUSHBUTTON   "Close",IDOK,266,156,52,15
END


